<% layout("layouts/boilerplates") %>

<div class="new-listing-page">

    <div class="new-listing-container">

        <h1>Create a New Listing</h1>

<form method="POST" action="/listings" class="needs-validation" novalidate>

    <div class="new-form-group">
        <label for="title">Title</label>
        <input
            type="text"
            id="title"
            name="listing[title]"
            placeholder="My Home"
            
        />
        <div class="valid-feedback">Looks good!</div>
    </div>


    <div class="new-form-group">
        <label for="description">Description</label>
        <textarea
            id="description"
            name="listing[description]"
            placeholder="It is a sweet place"
            required
        ></textarea>
        <div class="valid-feedback">Looks good!</div>
    </div>

    <div class="new-form-group">
        <label for="image">Image Link</label>
        <input
            type="text"
            id="image"
            name="listing[image][url]"
            placeholder="enter image URL/Link"
        />
        <div class="valid-feedback">Looks good!</div>
    </div>

    <div class="new-form-row">

        <div class="new-form-group new-price">
            <label for="price">Price</label>
            <input
                id="price"
                name="listing[price]"
                placeholder="1200"
                required
            />
            <div class="invalid-feedback"> price should be a positive number</div>
        </div>

        <div class="new-form-group new-country">
            <label for="country">Country</label>
            <input
                type="text"
                id="country"
                name="listing[country]"
                placeholder="India"
                required
            >
        </div>

    </div>

    <div class="new-form-group">
        <label for="location">Location</label>
        <input
            type="text"
            id="location"
            name="listing[location]"
            placeholder="Jaipur, Rajasthan"
            required
        >
        <div class="valid-feedback">Looks good!</div>
    </div>

    <button type="submit" class="new-add-btn">
        Add
    </button>

</form>

    </div>

</div>
<script src="/js/script.js"></script>